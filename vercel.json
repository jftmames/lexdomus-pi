{
  "version": 2,
  "builds": [
    {
      "src": "web/package.json",
      "use": "@vercel/next@11.0.3",
      "config": {
        "installCommand": "npm ci --no-audit --no-fund",
        "buildCommand": "npm run build"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/web/$1"
    }
  ]
}
